      attr_accessor route: String?

      attr_reader send_customer_emails: bool?

      def send_customer_emails=: (bool) -> bool

      attr_reader show_joined_whops: bool?

      def show_joined_whops=: (bool) -> bool

      attr_reader show_reviews_dtc: bool?

      def show_reviews_dtc=: (bool) -> bool

      attr_reader show_user_directory: bool?

      def show_user_directory=: (bool) -> bool

      attr_reader social_links: ::Array[::Hash[Symbol, top]]?

      def social_links=: (
        ::Array[::Hash[Symbol, top]]
      ) -> ::Array[::Hash[Symbol, top]]

      attr_accessor store_page_config: ::Hash[Symbol, top]?

      attr_accessor target_audience: String?

