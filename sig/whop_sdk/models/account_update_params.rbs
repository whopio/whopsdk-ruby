      attr_accessor title: String?

      attr_reader use_logo_as_opengraph_image_fallback: bool?

      def use_logo_as_opengraph_image_fallback=: (bool) -> bool

      def initialize: (
        account_id: String,
        ?affiliate_application_required: bool,
