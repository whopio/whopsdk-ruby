module WhopSDK
  module Models
    type app =
      {
        id: String,
        api_key: WhopSDK::App::APIKey?,
        app_type: WhopSDK::Models::app_type,
        base_url: String?,
        company: WhopSDK::App::Company,
        creator: WhopSDK::App::Creator,
        dashboard_path: String?,
        default_api_key: WhopSDK::App::DefaultAPIKey?,
        description: String?,
        discover_path: String?,
        domain_id: String,
        experience_path: String?,
        hosted_url: String?,
        icon: WhopSDK::App::Icon?,
        marketplace_status: WhopSDK::Models::App::marketplace_status?,
        name: String,
        oauth_client_type: WhopSDK::Models::App::oauth_client_type,
        openapi_path: String?,
        origin: String?,
        product_id: String?,
        production_web_build: WhopSDK::App::ProductionWebBuild?,
        redirect_uris: ::Array[String],
        requested_permissions: ::Array[WhopSDK::App::RequestedPermission],
        route: String?,
        secrets: ::Hash[Symbol, top]?,
        skills_path: String?,
        stats: WhopSDK::App::Stats?,
        status: WhopSDK::Models::app_statuses,
        verified: bool
      }

    class App < WhopSDK::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor api_key: WhopSDK::App::APIKey?

      attr_accessor app_type: WhopSDK::Models::app_type

      attr_accessor base_url: String?

      attr_accessor company: WhopSDK::App::Company

      attr_accessor creator: WhopSDK::App::Creator

      attr_accessor dashboard_path: String?

      attr_accessor default_api_key: WhopSDK::App::DefaultAPIKey?

      attr_accessor description: String?

      attr_accessor discover_path: String?

      attr_accessor domain_id: String

      attr_accessor experience_path: String?

      attr_accessor hosted_url: String?

      attr_accessor icon: WhopSDK::App::Icon?

      attr_accessor marketplace_status: WhopSDK::Models::App::marketplace_status?

      attr_accessor name: String

      attr_accessor oauth_client_type: WhopSDK::Models::App::oauth_client_type

      attr_accessor openapi_path: String?

      attr_accessor origin: String?

      attr_accessor product_id: String?

      attr_accessor production_web_build: WhopSDK::App::ProductionWebBuild?

      attr_accessor redirect_uris: ::Array[String]

      attr_accessor requested_permissions: ::Array[WhopSDK::App::RequestedPermission]

      attr_accessor route: String?

      attr_accessor secrets: ::Hash[Symbol, top]?

      attr_accessor skills_path: String?

      attr_accessor stats: WhopSDK::App::Stats?

      attr_accessor status: WhopSDK::Models::app_statuses

      attr_accessor verified: bool

      def initialize: (
        id: String,
        api_key: WhopSDK::App::APIKey?,
        app_type: WhopSDK::Models::app_type,
        base_url: String?,
        company: WhopSDK::App::Company,
        creator: WhopSDK::App::Creator,
        dashboard_path: String?,
        default_api_key: WhopSDK::App::DefaultAPIKey?,
        description: String?,
        discover_path: String?,
        domain_id: String,
        experience_path: String?,
        hosted_url: String?,
        icon: WhopSDK::App::Icon?,
        marketplace_status: WhopSDK::Models::App::marketplace_status?,
        name: String,
        oauth_client_type: WhopSDK::Models::App::oauth_client_type,
        openapi_path: String?,
        origin: String?,
        product_id: String?,
        production_web_build: WhopSDK::App::ProductionWebBuild?,
        redirect_uris: ::Array[String],
        requested_permissions: ::Array[WhopSDK::App::RequestedPermission],
        route: String?,
        secrets: ::Hash[Symbol, top]?,
        skills_path: String?,
        stats: WhopSDK::App::Stats?,
        status: WhopSDK::Models::app_statuses,
        verified: bool
      ) -> void

      def to_hash: -> {
        id: String,
        api_key: WhopSDK::App::APIKey?,
        app_type: WhopSDK::Models::app_type,
        base_url: String?,
        company: WhopSDK::App::Company,
        creator: WhopSDK::App::Creator,
        dashboard_path: String?,
        default_api_key: WhopSDK::App::DefaultAPIKey?,
        description: String?,
        discover_path: String?,
        domain_id: String,
        experience_path: String?,
        hosted_url: String?,
        icon: WhopSDK::App::Icon?,
        marketplace_status: WhopSDK::Models::App::marketplace_status?,
        name: String,
        oauth_client_type: WhopSDK::Models::App::oauth_client_type,
        openapi_path: String?,
        origin: String?,
        product_id: String?,
        production_web_build: WhopSDK::App::ProductionWebBuild?,
        redirect_uris: ::Array[String],
        requested_permissions: ::Array[WhopSDK::App::RequestedPermission],
        route: String?,
        secrets: ::Hash[Symbol, top]?,
        skills_path: String?,
        stats: WhopSDK::App::Stats?,
        status: WhopSDK::Models::app_statuses,
        verified: bool
      }

      type api_key = { id: String, token: String, created_at: Time }

      class APIKey < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor token: String

        attr_accessor created_at: Time

        def initialize: (id: String, token: String, created_at: Time) -> void

        def to_hash: -> { id: String, token: String, created_at: Time }
      end

      type company = { id: String, title: String }

      class Company < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor title: String

        def initialize: (id: String, title: String) -> void

        def to_hash: -> { id: String, title: String }
      end

      type creator = { id: String, name: String?, username: String }

      class Creator < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor name: String?

        attr_accessor username: String

        def initialize: (id: String, name: String?, username: String) -> void

        def to_hash: -> { id: String, name: String?, username: String }
      end

      type default_api_key =
        {
          id: String,
          name: String?,
          obfuscated_secret_key: String,
          secret_key: String?
        }

      class DefaultAPIKey < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor name: String?

        attr_accessor obfuscated_secret_key: String

        attr_accessor secret_key: String?

        def initialize: (
          id: String,
          name: String?,
          obfuscated_secret_key: String,
          secret_key: String?
        ) -> void

        def to_hash: -> {
          id: String,
          name: String?,
          obfuscated_secret_key: String,
          secret_key: String?
        }
      end

      type icon = { url: String? }

      class Icon < WhopSDK::Internal::Type::BaseModel
        attr_accessor url: String?

        def initialize: (url: String?) -> void

        def to_hash: -> { url: String? }
      end

      type marketplace_status =
        :not_available | :pending_review | :live_marketplace

      module MarketplaceStatus
        extend WhopSDK::Internal::Type::Enum

        NOT_AVAILABLE: :not_available
        PENDING_REVIEW: :pending_review
        LIVE_MARKETPLACE: :live_marketplace

        def self?.values: -> ::Array[WhopSDK::Models::App::marketplace_status]
      end

      type oauth_client_type = :public | :confidential

      module OAuthClientType
        extend WhopSDK::Internal::Type::Enum

        PUBLIC: :public
        CONFIDENTIAL: :confidential

        def self?.values: -> ::Array[WhopSDK::Models::App::oauth_client_type]
      end

      type production_web_build =
        {
          id: String,
          checksum: String,
          file_url: String,
          source_url: String?,
          status: WhopSDK::Models::app_build_statuses
        }

      class ProductionWebBuild < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor checksum: String

        attr_accessor file_url: String

        attr_accessor source_url: String?

        attr_accessor status: WhopSDK::Models::app_build_statuses

        def initialize: (
          id: String,
          checksum: String,
          file_url: String,
          source_url: String?,
          status: WhopSDK::Models::app_build_statuses
        ) -> void

        def to_hash: -> {
          id: String,
          checksum: String,
          file_url: String,
          source_url: String?,
          status: WhopSDK::Models::app_build_statuses
        }
      end

      type requested_permission =
        {
          is_required: bool,
          justification: String,
          permission_action: WhopSDK::App::RequestedPermission::PermissionAction
        }

      class RequestedPermission < WhopSDK::Internal::Type::BaseModel
        attr_accessor is_required: bool

        attr_accessor justification: String

        attr_accessor permission_action: WhopSDK::App::RequestedPermission::PermissionAction

        def initialize: (
          is_required: bool,
          justification: String,
          permission_action: WhopSDK::App::RequestedPermission::PermissionAction
        ) -> void

        def to_hash: -> {
          is_required: bool,
          justification: String,
          permission_action: WhopSDK::App::RequestedPermission::PermissionAction
        }

        type permission_action = { action: String, name: String }

        class PermissionAction < WhopSDK::Internal::Type::BaseModel
          attr_accessor action: String

          attr_accessor name: String

          def initialize: (action: String, name: String) -> void

          def to_hash: -> { action: String, name: String }
        end
      end

      type stats =
        {
          dau: Integer,
          mau: Integer,
          :time_spent_last24_hours => Integer,
          wau: Integer
        }

      class Stats < WhopSDK::Internal::Type::BaseModel
        attr_accessor dau: Integer

        attr_accessor mau: Integer

        attr_accessor time_spent_last24_hours: Integer

        attr_accessor wau: Integer

        def initialize: (
          dau: Integer,
          mau: Integer,
          time_spent_last24_hours: Integer,
          wau: Integer
        ) -> void

        def to_hash: -> {
          dau: Integer,
          mau: Integer,
          :time_spent_last24_hours => Integer,
          wau: Integer
        }
      end
    end
