module WhopSDK
  module Models
    type app_build =
      {
        id: String,
        checksum: String,
        created_at: String,
        file_url: String?,
        is_production: bool,
        platform: WhopSDK::Models::AppBuild::platform,
        review_message: String?,
        source_url: String?,
        status: WhopSDK::Models::AppBuild::status,
        supported_app_view_types: ::Array[WhopSDK::Models::AppBuild::supported_app_view_type]
      }

    class AppBuild < WhopSDK::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor checksum: String

      attr_accessor created_at: String

      attr_accessor file_url: String?

      attr_accessor is_production: bool

      attr_accessor platform: WhopSDK::Models::AppBuild::platform

      attr_accessor review_message: String?

      attr_accessor source_url: String?

      attr_accessor status: WhopSDK::Models::AppBuild::status

      attr_accessor supported_app_view_types: ::Array[WhopSDK::Models::AppBuild::supported_app_view_type]

      def initialize: (
        id: String,
        checksum: String,
        created_at: String,
        file_url: String?,
        is_production: bool,
        platform: WhopSDK::Models::AppBuild::platform,
        review_message: String?,
        source_url: String?,
        status: WhopSDK::Models::AppBuild::status,
        supported_app_view_types: ::Array[WhopSDK::Models::AppBuild::supported_app_view_type]
      ) -> void

      def to_hash: -> {
        id: String,
        checksum: String,
        created_at: String,
        file_url: String?,
        is_production: bool,
        platform: WhopSDK::Models::AppBuild::platform,
        review_message: String?,
        source_url: String?,
        status: WhopSDK::Models::AppBuild::status,
        supported_app_view_types: ::Array[WhopSDK::Models::AppBuild::supported_app_view_type]
      }

      type platform = :ios | :android | :web

      module Platform
        extend WhopSDK::Internal::Type::Enum

        IOS: :ios
        ANDROID: :android
        WEB: :web

        def self?.values: -> ::Array[WhopSDK::Models::AppBuild::platform]
      end

      type status = :draft | :pending | :approved | :rejected

      module Status
        extend WhopSDK::Internal::Type::Enum

        DRAFT: :draft
        PENDING: :pending
        APPROVED: :approved
        REJECTED: :rejected

        def self?.values: -> ::Array[WhopSDK::Models::AppBuild::status]
      end

      type supported_app_view_type =
        :hub | :discover | :dash | :dashboard | :analytics | :skills | :openapi

      module SupportedAppViewType
        extend WhopSDK::Internal::Type::Enum

        HUB: :hub
        DISCOVER: :discover
        DASH: :dash
        DASHBOARD: :dashboard
        ANALYTICS: :analytics
        SKILLS: :skills
        OPENAPI: :openapi

        def self?.values: -> ::Array[WhopSDK::Models::AppBuild::supported_app_view_type]
      end
    end
  end
end
