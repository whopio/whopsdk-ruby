        attr_accessor trial_period_days: Integer?

        attr_accessor visibility: WhopSDK::Models::CheckoutConfiguration::Plan::visibility

        def initialize: (
          id: String,
          adaptive_pricing_enabled: bool,
          billing_period: Integer?,
          currency: String,
          expiration_days: Integer?,
