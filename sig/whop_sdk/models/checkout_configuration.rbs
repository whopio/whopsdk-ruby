      type effective_payment_method_configuration =
        {
          disabled: ::Array[String],
          enabled: ::Array[String],
          include_platform_defaults: bool
        }

      class EffectivePaymentMethodConfiguration < WhopSDK::Internal::Type::BaseModel
        attr_accessor disabled: ::Array[String]

        attr_accessor enabled: ::Array[String]

        attr_accessor include_platform_defaults: bool

