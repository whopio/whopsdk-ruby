    type checkout_configuration =
      {
        id: String,
        account_id: String,
        affiliate_code: String?,
        created_at: String,
        currency: WhopSDK::Models::CheckoutConfiguration::currency?,
        effective_payment_method_configuration: WhopSDK::CheckoutConfiguration::EffectivePaymentMethodConfiguration?,
