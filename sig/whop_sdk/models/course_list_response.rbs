module WhopSDK
  module Models
    type course_list_response =
      {
        id: String,
        certificate_after_completion_enabled: bool?,
        chapters_count: Integer,
        completed_lessons_count: Integer,
        cover_image: String?,
        created_at: Time,
        description: String?,
        language: WhopSDK::Models::languages,
        latest_lesson_created_at: Time?,
        lesson_unlock_days: ::Array[Integer],
        order: String,
        require_completing_lessons_in_order: bool,
        resume_lesson: WhopSDK::Models::CourseListResponse::ResumeLesson?,
        started_at: Time?,
        tagline: String?,
        thumbnail: WhopSDK::Models::CourseListResponse::Thumbnail?,
        title: String?,
        total_duration_seconds: Integer,
        total_lessons_count: Integer,
        updated_at: Time,
        visibility: WhopSDK::Models::course_visibilities
      }

    class CourseListResponse < WhopSDK::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor certificate_after_completion_enabled: bool?

      attr_accessor chapters_count: Integer

      attr_accessor completed_lessons_count: Integer

      attr_accessor cover_image: String?

      attr_accessor created_at: Time

      attr_accessor description: String?

      attr_accessor language: WhopSDK::Models::languages

      attr_accessor latest_lesson_created_at: Time?

      attr_accessor lesson_unlock_days: ::Array[Integer]

      attr_accessor order: String

      attr_accessor require_completing_lessons_in_order: bool

      attr_accessor resume_lesson: WhopSDK::Models::CourseListResponse::ResumeLesson?

      attr_accessor started_at: Time?

      attr_accessor tagline: String?

      attr_accessor thumbnail: WhopSDK::Models::CourseListResponse::Thumbnail?

      attr_accessor title: String?

      attr_accessor total_duration_seconds: Integer

      attr_accessor total_lessons_count: Integer

      attr_accessor updated_at: Time

      attr_accessor visibility: WhopSDK::Models::course_visibilities

      def initialize: (
        id: String,
        certificate_after_completion_enabled: bool?,
        chapters_count: Integer,
        completed_lessons_count: Integer,
        cover_image: String?,
        created_at: Time,
        description: String?,
        language: WhopSDK::Models::languages,
        latest_lesson_created_at: Time?,
        lesson_unlock_days: ::Array[Integer],
        order: String,
        require_completing_lessons_in_order: bool,
        resume_lesson: WhopSDK::Models::CourseListResponse::ResumeLesson?,
        started_at: Time?,
        tagline: String?,
        thumbnail: WhopSDK::Models::CourseListResponse::Thumbnail?,
        title: String?,
        total_duration_seconds: Integer,
        total_lessons_count: Integer,
        updated_at: Time,
        visibility: WhopSDK::Models::course_visibilities
      ) -> void

      def to_hash: -> {
        id: String,
        certificate_after_completion_enabled: bool?,
        chapters_count: Integer,
        completed_lessons_count: Integer,
        cover_image: String?,
        created_at: Time,
        description: String?,
        language: WhopSDK::Models::languages,
        latest_lesson_created_at: Time?,
        lesson_unlock_days: ::Array[Integer],
        order: String,
        require_completing_lessons_in_order: bool,
        resume_lesson: WhopSDK::Models::CourseListResponse::ResumeLesson?,
        started_at: Time?,
        tagline: String?,
        thumbnail: WhopSDK::Models::CourseListResponse::Thumbnail?,
        title: String?,
        total_duration_seconds: Integer,
        total_lessons_count: Integer,
        updated_at: Time,
        visibility: WhopSDK::Models::course_visibilities
      }

      type resume_lesson = { id: String }

      class ResumeLesson < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        def initialize: (id: String) -> void

        def to_hash: -> { id: String }
      end

      type thumbnail =
        {
          id: String,
          content_type: String?,
          filename: String?,
          optimized_url: String?,
          source_url: String?
        }

      class Thumbnail < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor content_type: String?

        attr_accessor filename: String?

        attr_accessor optimized_url: String?

        attr_accessor source_url: String?

        def initialize: (
          id: String,
          content_type: String?,
          filename: String?,
          optimized_url: String?,
          source_url: String?
        ) -> void

        def to_hash: -> {
          id: String,
          content_type: String?,
          filename: String?,
          optimized_url: String?,
          source_url: String?
        }
      end
    end
  end
end
