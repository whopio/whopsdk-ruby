module WhopSDK
  module Models
    type membership =
      {
        id: String,
        account: WhopSDK::Membership::Account,
        cancel_at_period_end: bool,
        created_at: String,
        current_period_end: String?,
        license_key: String?,
        member: WhopSDK::Membership::Member?,
        metadata: top,
        phone_number: String?,
        plan_id: String,
        product_id: String,
        status: WhopSDK::Models::Membership::status,
        user_id: String?
      }

    class Membership < WhopSDK::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor account: WhopSDK::Membership::Account

      attr_accessor cancel_at_period_end: bool

      attr_accessor created_at: String

      attr_accessor current_period_end: String?

      attr_accessor license_key: String?

      attr_accessor member: WhopSDK::Membership::Member?

      attr_accessor metadata: top

      attr_accessor phone_number: String?

      attr_accessor plan_id: String

      attr_accessor product_id: String

      attr_accessor status: WhopSDK::Models::Membership::status

      attr_accessor user_id: String?

      def initialize: (
        id: String,
        account: WhopSDK::Membership::Account,
        cancel_at_period_end: bool,
        created_at: String,
        current_period_end: String?,
        license_key: String?,
        member: WhopSDK::Membership::Member?,
        metadata: top,
        phone_number: String?,
        plan_id: String,
        product_id: String,
        status: WhopSDK::Models::Membership::status,
        user_id: String?
      ) -> void

      def to_hash: -> {
        id: String,
        account: WhopSDK::Membership::Account,
        cancel_at_period_end: bool,
        created_at: String,
        current_period_end: String?,
        license_key: String?,
        member: WhopSDK::Membership::Member?,
        metadata: top,
        phone_number: String?,
        plan_id: String,
        product_id: String,
        status: WhopSDK::Models::Membership::status,
        user_id: String?
      }

      type account =
        { id: String, logo_url: String?, route: String, title: String }

      class Account < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor logo_url: String?

        attr_accessor route: String

        attr_accessor title: String

        def initialize: (
          id: String,
          logo_url: String?,
          route: String,
          title: String
        ) -> void

        def to_hash: -> {
          id: String,
          logo_url: String?,
          route: String,
          title: String
        }
      end

      type member =
        {
          access_level: WhopSDK::Models::Membership::Member::access_level,
          last_accessed_at: String?,
          position: Float?
        }

      class Member < WhopSDK::Internal::Type::BaseModel
        attr_accessor access_level: WhopSDK::Models::Membership::Member::access_level

        attr_accessor last_accessed_at: String?

        attr_accessor position: Float?

        def initialize: (
          access_level: WhopSDK::Models::Membership::Member::access_level,
          last_accessed_at: String?,
          position: Float?
        ) -> void

        def to_hash: -> {
          access_level: WhopSDK::Models::Membership::Member::access_level,
          last_accessed_at: String?,
          position: Float?
        }

        type access_level = :no_access | :admin | :customer

        module AccessLevel
          extend WhopSDK::Internal::Type::Enum

          NO_ACCESS: :no_access
          ADMIN: :admin
          CUSTOMER: :customer

          def self?.values: -> ::Array[WhopSDK::Models::Membership::Member::access_level]
        end
      end

      type status =
        :trialing
        | :active
        | :past_due
        | :completed
        | :canceled
        | :expired
        | :unresolved

      module Status
        extend WhopSDK::Internal::Type::Enum

        TRIALING: :trialing
        ACTIVE: :active
        PAST_DUE: :past_due
        COMPLETED: :completed
        CANCELED: :canceled
        EXPIRED: :expired
        UNRESOLVED: :unresolved

        def self?.values: -> ::Array[WhopSDK::Models::Membership::status]
      end
    end
  end
end
