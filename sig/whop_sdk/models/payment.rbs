        def self?.values: -> ::Array[WhopSDK::Models::Payment::decline_code]
      end

      type payment_instrument =
        {
          card: WhopSDK::Payment::PaymentInstrument::Card?,
          display_name: String,
          icons: WhopSDK::Payment::PaymentInstrument::Icons,
          installment_count: Float?,
          payment_method_type: String
        }

      class PaymentInstrument < WhopSDK::Internal::Type::BaseModel
        attr_accessor card: WhopSDK::Payment::PaymentInstrument::Card?

        attr_accessor display_name: String

        attr_accessor icons: WhopSDK::Payment::PaymentInstrument::Icons

        attr_accessor installment_count: Float?

        attr_accessor payment_method_type: String

