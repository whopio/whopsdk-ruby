module WhopSDK
  module Models
    type payment =
      {
        id: String,
        account_id: String?,
        amount_after_fees: WhopSDK::Payment::AmountAfterFees,
        auto_refunded: bool,
        billing_address: WhopSDK::Payment::BillingAddress?,
        billing_reason: WhopSDK::Models::billing_reasons?,
        checkout_configuration_id: String?,
        client_secret: String?,
        created_at: String,
        currency: WhopSDK::Models::currency,
        customer_phone: String?,
        decline_code: WhopSDK::Models::Payment::decline_code?,
        dispute_alerted_at: String?,
        failure_message: String?,
        financing_installments_count: Float?,
        last_payment_attempt_at: String?,
        member_id: String?,
        membership_id: String?,
        metadata: top?,
        needs_tracking: bool?,
        next_payment_attempt_at: String?,
        paid_at: String?,
        payment_instrument: WhopSDK::Payment::PaymentInstrument?,
        payment_method_id: String?,
        payment_method_type: WhopSDK::Models::payment_method_types?,
        payments_failed: Float,
        plan_id: String?,
        product_id: String?,
        promo_code_id: String?,
        refundable: bool,
        refunded_amount: WhopSDK::Payment::RefundedAmount?,
        refunded_at: String?,
        retryable: bool,
        risk_score: Float?,
        risk_signals: top?,
        settlement_time_at: String?,
        shipment_id: String?,
        shipping_address: WhopSDK::Payment::ShippingAddress?,
        status: WhopSDK::Models::receipt_status,
        substatus: WhopSDK::Models::friendly_receipt_status,
        subtotal: WhopSDK::Payment::Subtotal?,
        tax_amount: WhopSDK::Payment::TaxAmount?,
        tax_behavior: WhopSDK::Models::receipt_tax_behavior?,
        tax_refunded_amount: WhopSDK::Payment::TaxRefundedAmount,
        three_ds_verified: bool,
        total: WhopSDK::Payment::Total?,
        updated_at: String,
        usd_total: WhopSDK::Payment::UsdTotal?,
        user: WhopSDK::Payment::User?,
        verification_checks: WhopSDK::Payment::VerificationChecks?,
        voidable: bool
      }

