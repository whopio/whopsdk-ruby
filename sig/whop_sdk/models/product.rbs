module WhopSDK
  module Models
    type product =
      {
        id: String,
        account: top?,
        created_at: String,
        custom_cta: WhopSDK::Models::Product::custom_cta?,
        custom_cta_url: String?,
        custom_statement_descriptor: String?,
        default_plan: WhopSDK::Product::DefaultPlan?,
        description: String?,
        external_identifier: String?,
        gallery_images: ::Array[WhopSDK::Product::GalleryImage],
        global_affiliate_percentage: Float?,
        global_affiliate_status: WhopSDK::Models::Product::global_affiliate_status?,
        headline: String?,
        labels: ::Array[String],
        marketplace_status: WhopSDK::Models::Product::marketplace_status,
        member_affiliate_percentage: Float?,
        member_affiliate_status: WhopSDK::Models::Product::member_affiliate_status?,
        member_count: Float,
        metadata: top?,
        owner_user: top?,
        product_tax_code: top?,
        published_reviews_count: Float,
        route: String,
        title: String,
        updated_at: String,
        verified: bool,
        visibility: String?
      }

    class Product < WhopSDK::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor account: top?

      attr_accessor created_at: String

      attr_accessor custom_cta: WhopSDK::Models::Product::custom_cta?

      attr_accessor custom_cta_url: String?

      attr_accessor custom_statement_descriptor: String?

      attr_accessor default_plan: WhopSDK::Product::DefaultPlan?

      attr_accessor description: String?

      attr_accessor external_identifier: String?

      attr_accessor gallery_images: ::Array[WhopSDK::Product::GalleryImage]

      attr_accessor global_affiliate_percentage: Float?

      attr_accessor global_affiliate_status: WhopSDK::Models::Product::global_affiliate_status?

      attr_accessor headline: String?

      attr_accessor labels: ::Array[String]

      attr_accessor marketplace_status: WhopSDK::Models::Product::marketplace_status

      attr_accessor member_affiliate_percentage: Float?

      attr_accessor member_affiliate_status: WhopSDK::Models::Product::member_affiliate_status?

      attr_accessor member_count: Float

      attr_accessor metadata: top?

      attr_accessor owner_user: top?

      attr_accessor product_tax_code: top?

      attr_accessor published_reviews_count: Float

      attr_accessor route: String

      attr_accessor title: String

      attr_accessor updated_at: String

      attr_accessor verified: bool

      attr_accessor visibility: String?

      def initialize: (
        id: String,
        account: top?,
        created_at: String,
        custom_cta: WhopSDK::Models::Product::custom_cta?,
        custom_cta_url: String?,
        custom_statement_descriptor: String?,
        default_plan: WhopSDK::Product::DefaultPlan?,
        description: String?,
        external_identifier: String?,
        gallery_images: ::Array[WhopSDK::Product::GalleryImage],
        global_affiliate_percentage: Float?,
        global_affiliate_status: WhopSDK::Models::Product::global_affiliate_status?,
        headline: String?,
        labels: ::Array[String],
        marketplace_status: WhopSDK::Models::Product::marketplace_status,
        member_affiliate_percentage: Float?,
        member_affiliate_status: WhopSDK::Models::Product::member_affiliate_status?,
        member_count: Float,
        metadata: top?,
        owner_user: top?,
        product_tax_code: top?,
        published_reviews_count: Float,
        route: String,
        title: String,
        updated_at: String,
        verified: bool,
        visibility: String?
      ) -> void

      def to_hash: -> {
        id: String,
        account: top?,
        created_at: String,
        custom_cta: WhopSDK::Models::Product::custom_cta?,
        custom_cta_url: String?,
        custom_statement_descriptor: String?,
        default_plan: WhopSDK::Product::DefaultPlan?,
        description: String?,
        external_identifier: String?,
        gallery_images: ::Array[WhopSDK::Product::GalleryImage],
        global_affiliate_percentage: Float?,
        global_affiliate_status: WhopSDK::Models::Product::global_affiliate_status?,
        headline: String?,
        labels: ::Array[String],
        marketplace_status: WhopSDK::Models::Product::marketplace_status,
        member_affiliate_percentage: Float?,
        member_affiliate_status: WhopSDK::Models::Product::member_affiliate_status?,
        member_count: Float,
        metadata: top?,
        owner_user: top?,
        product_tax_code: top?,
        published_reviews_count: Float,
        route: String,
        title: String,
        updated_at: String,
        verified: bool,
        visibility: String?
      }

      type custom_cta =
        :get_access
        | :join
        | :order_now
        | :shop_now
        | :call_now
        | :donate_now
        | :contact_us
        | :sign_up
        | :subscribe
        | :purchase
        | :get_offer
        | :apply_now
        | :complete_order

      module CustomCta
        extend WhopSDK::Internal::Type::Enum

        GET_ACCESS: :get_access
        JOIN: :join
        ORDER_NOW: :order_now
        SHOP_NOW: :shop_now
        CALL_NOW: :call_now
        DONATE_NOW: :donate_now
        CONTACT_US: :contact_us
        SIGN_UP: :sign_up
        SUBSCRIBE: :subscribe
        PURCHASE: :purchase
        GET_OFFER: :get_offer
        APPLY_NOW: :apply_now
        COMPLETE_ORDER: :complete_order

        def self?.values: -> ::Array[WhopSDK::Models::Product::custom_cta]
      end

      type default_plan =
        {
          id: String,
          billing_period: Float?,
          expiration_days: Float?,
          initial_price: WhopSDK::Product::DefaultPlan::InitialPrice,
          plan_type: WhopSDK::Models::Product::DefaultPlan::plan_type,
          renewal_price: WhopSDK::Product::DefaultPlan::RenewalPrice,
          title: String?,
          unlimited_stock: bool,
          visibility: WhopSDK::Models::Product::DefaultPlan::visibility
        }

      class DefaultPlan < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor billing_period: Float?

        attr_accessor expiration_days: Float?

        attr_accessor initial_price: WhopSDK::Product::DefaultPlan::InitialPrice

        attr_accessor plan_type: WhopSDK::Models::Product::DefaultPlan::plan_type

        attr_accessor renewal_price: WhopSDK::Product::DefaultPlan::RenewalPrice

        attr_accessor title: String?

        attr_accessor unlimited_stock: bool

        attr_accessor visibility: WhopSDK::Models::Product::DefaultPlan::visibility

        def initialize: (
          id: String,
          billing_period: Float?,
          expiration_days: Float?,
          initial_price: WhopSDK::Product::DefaultPlan::InitialPrice,
          plan_type: WhopSDK::Models::Product::DefaultPlan::plan_type,
          renewal_price: WhopSDK::Product::DefaultPlan::RenewalPrice,
          title: String?,
          unlimited_stock: bool,
          visibility: WhopSDK::Models::Product::DefaultPlan::visibility
        ) -> void

        def to_hash: -> {
          id: String,
          billing_period: Float?,
          expiration_days: Float?,
          initial_price: WhopSDK::Product::DefaultPlan::InitialPrice,
          plan_type: WhopSDK::Models::Product::DefaultPlan::plan_type,
          renewal_price: WhopSDK::Product::DefaultPlan::RenewalPrice,
          title: String?,
          unlimited_stock: bool,
          visibility: WhopSDK::Models::Product::DefaultPlan::visibility
        }

        type initial_price =
          {
            amount: String,
            currency: String,
            decimals: Integer,
            display_decimals: Integer
          }

        class InitialPrice < WhopSDK::Internal::Type::BaseModel
          attr_accessor amount: String

          attr_accessor currency: String

          attr_accessor decimals: Integer

          attr_accessor display_decimals: Integer

          def initialize: (
            amount: String,
            currency: String,
            decimals: Integer,
            display_decimals: Integer
          ) -> void

          def to_hash: -> {
            amount: String,
            currency: String,
            decimals: Integer,
            display_decimals: Integer
          }
        end

        type plan_type = :renewal | :one_time

        module PlanType
          extend WhopSDK::Internal::Type::Enum

          RENEWAL: :renewal
          ONE_TIME: :one_time

          def self?.values: -> ::Array[WhopSDK::Models::Product::DefaultPlan::plan_type]
        end

        type renewal_price =
          {
            amount: String,
            currency: String,
            decimals: Integer,
            display_decimals: Integer
          }

        class RenewalPrice < WhopSDK::Internal::Type::BaseModel
          attr_accessor amount: String

          attr_accessor currency: String

          attr_accessor decimals: Integer

          attr_accessor display_decimals: Integer

          def initialize: (
            amount: String,
            currency: String,
            decimals: Integer,
            display_decimals: Integer
          ) -> void

          def to_hash: -> {
            amount: String,
            currency: String,
            decimals: Integer,
            display_decimals: Integer
          }
        end

        type visibility = :visible | :hidden | :archived | :quick_link

        module Visibility
          extend WhopSDK::Internal::Type::Enum

          VISIBLE: :visible
          HIDDEN: :hidden
          ARCHIVED: :archived
          QUICK_LINK: :quick_link

          def self?.values: -> ::Array[WhopSDK::Models::Product::DefaultPlan::visibility]
        end
      end

      type gallery_image = { id: String, content_type: String?, url: String? }

      class GalleryImage < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor content_type: String?

        attr_accessor url: String?

        def initialize: (
          id: String,
          content_type: String?,
          url: String?
        ) -> void

        def to_hash: -> { id: String, content_type: String?, url: String? }
      end

      type global_affiliate_status = :enabled | :disabled

      module GlobalAffiliateStatus
        extend WhopSDK::Internal::Type::Enum

        ENABLED: :enabled
        DISABLED: :disabled

        def self?.values: -> ::Array[WhopSDK::Models::Product::global_affiliate_status]
      end

      type marketplace_status =
        :not_available | :pending_review | :live_marketplace

      module MarketplaceStatus
        extend WhopSDK::Internal::Type::Enum

        NOT_AVAILABLE: :not_available
        PENDING_REVIEW: :pending_review
        LIVE_MARKETPLACE: :live_marketplace

        def self?.values: -> ::Array[WhopSDK::Models::Product::marketplace_status]
      end

      type member_affiliate_status = :enabled | :disabled

      module MemberAffiliateStatus
        extend WhopSDK::Internal::Type::Enum

        ENABLED: :enabled
        DISABLED: :disabled

        def self?.values: -> ::Array[WhopSDK::Models::Product::member_affiliate_status]
      end
    end
  end
end
