module WhopSDK
  module Models
    type product_update_params =
      {
        id: String,
        description: String?,
        headline: String?,
        metadata: top?,
        product_tax_code_id: String?,
        send_welcome_message: bool?,
        title: String,
        visibility: String
      }
      & WhopSDK::Internal::Type::request_parameters

    class ProductUpdateParams < WhopSDK::Internal::Type::BaseModel
      extend WhopSDK::Internal::Type::RequestParameters::Converter
      include WhopSDK::Internal::Type::RequestParameters

      attr_accessor id: String

      attr_accessor description: String?

      attr_accessor headline: String?

      attr_accessor metadata: top?

      attr_accessor product_tax_code_id: String?

      attr_accessor send_welcome_message: bool?

      attr_reader title: String?

      def title=: (String) -> String

      attr_reader visibility: String?

      def visibility=: (String) -> String

      def initialize: (
        id: String,
        ?description: String?,
        ?headline: String?,
        ?metadata: top?,
        ?product_tax_code_id: String?,
        ?send_welcome_message: bool?,
        ?title: String,
        ?visibility: String,
        ?request_options: WhopSDK::request_opts
      ) -> void

      def to_hash: -> {
        id: String,
        description: String?,
        headline: String?,
        metadata: top?,
        product_tax_code_id: String?,
        send_welcome_message: bool?,
        title: String,
        visibility: String,
        request_options: WhopSDK::RequestOptions
      }
    end
  end
end
