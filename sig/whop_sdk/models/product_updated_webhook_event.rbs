module WhopSDK
  module Models
    type product_updated_webhook_event =
      {
        id: String,
        api_version: :v1,
        api_version_date: String?,
        data: WhopSDK::Product,
        timestamp: Time,
        type: :"product.updated",
        company_id: String?
      }

    class ProductUpdatedWebhookEvent < WhopSDK::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor api_version: :v1

      attr_accessor api_version_date: String?

      attr_accessor data: WhopSDK::Product

      attr_accessor timestamp: Time

      attr_accessor type: :"product.updated"

      attr_accessor company_id: String?

      def initialize: (
        id: String,
        api_version_date: String?,
        data: WhopSDK::Product,
        timestamp: Time,
        ?company_id: String?,
        ?api_version: :v1,
        ?type: :"product.updated"
      ) -> void

      def to_hash: -> {
        id: String,
        api_version: :v1,
        api_version_date: String?,
        data: WhopSDK::Product,
        timestamp: Time,
        type: :"product.updated",
        company_id: String?
      }
