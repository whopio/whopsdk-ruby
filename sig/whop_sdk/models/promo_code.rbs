      type duration = :forever | :once | :repeating

      module Duration
        extend WhopSDK::Internal::Type::Enum

        FOREVER: :forever
        ONCE: :once
        REPEATING: :repeating

        def self?.values: -> ::Array[WhopSDK::Models::PromoCode::duration]
      end

      type product = { id: String, title: String }

      class Product < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor title: String

        def initialize: (id: String, title: String) -> void

        def to_hash: -> { id: String, title: String }
      end

      type promo_type = :percentage | :flat_amount

      module PromoType
        extend WhopSDK::Internal::Type::Enum

        PERCENTAGE: :percentage
        FLAT_AMOUNT: :flat_amount

        def self?.values: -> ::Array[WhopSDK::Models::PromoCode::promo_type]
      end

      type status = :active | :inactive | :archived

      module Status
        extend WhopSDK::Internal::Type::Enum

        ACTIVE: :active
        INACTIVE: :inactive
        ARCHIVED: :archived

        def self?.values: -> ::Array[WhopSDK::Models::PromoCode::status]
      end
