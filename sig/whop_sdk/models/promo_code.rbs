module WhopSDK
  module Models
    type promo_code =
      {
        id: String,
        account: WhopSDK::PromoCode::Account,
        amount_off: Float,
        churned_users_only: bool,
        code: String?,
        created_at: String,
        currency: WhopSDK::Models::PromoCode::currency,
        duration: WhopSDK::Models::PromoCode::duration,
        existing_memberships_only: bool,
        expires_at: String?,
        metadata: top,
        new_users_only: bool,
        one_per_customer: bool,
        product: WhopSDK::PromoCode::Product?,
        promo_duration_months: Integer?,
        promo_type: WhopSDK::Models::PromoCode::promo_type,
        status: WhopSDK::Models::PromoCode::status,
        stock: Integer,
        unlimited_stock: bool,
        updated_at: String,
        uses: Integer
      }

    class PromoCode < WhopSDK::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor account: WhopSDK::PromoCode::Account

      attr_accessor amount_off: Float

      attr_accessor churned_users_only: bool

      attr_accessor code: String?

      attr_accessor created_at: String

      attr_accessor currency: WhopSDK::Models::PromoCode::currency

      attr_accessor duration: WhopSDK::Models::PromoCode::duration

      attr_accessor existing_memberships_only: bool

      attr_accessor expires_at: String?

      attr_accessor metadata: top

      attr_accessor new_users_only: bool

      attr_accessor one_per_customer: bool

      attr_accessor product: WhopSDK::PromoCode::Product?

      attr_accessor promo_duration_months: Integer?

      attr_accessor promo_type: WhopSDK::Models::PromoCode::promo_type

      attr_accessor status: WhopSDK::Models::PromoCode::status

      attr_accessor stock: Integer

      attr_accessor unlimited_stock: bool

      attr_accessor updated_at: String

      attr_accessor uses: Integer

      def initialize: (
        id: String,
        account: WhopSDK::PromoCode::Account,
        amount_off: Float,
        churned_users_only: bool,
        code: String?,
        created_at: String,
        currency: WhopSDK::Models::PromoCode::currency,
        duration: WhopSDK::Models::PromoCode::duration,
        existing_memberships_only: bool,
        expires_at: String?,
        metadata: top,
        new_users_only: bool,
        one_per_customer: bool,
        product: WhopSDK::PromoCode::Product?,
        promo_duration_months: Integer?,
        promo_type: WhopSDK::Models::PromoCode::promo_type,
        status: WhopSDK::Models::PromoCode::status,
        stock: Integer,
        unlimited_stock: bool,
        updated_at: String,
        uses: Integer
      ) -> void

      def to_hash: -> {
        id: String,
        account: WhopSDK::PromoCode::Account,
        amount_off: Float,
        churned_users_only: bool,
        code: String?,
        created_at: String,
        currency: WhopSDK::Models::PromoCode::currency,
        duration: WhopSDK::Models::PromoCode::duration,
        existing_memberships_only: bool,
        expires_at: String?,
        metadata: top,
        new_users_only: bool,
        one_per_customer: bool,
        product: WhopSDK::PromoCode::Product?,
        promo_duration_months: Integer?,
        promo_type: WhopSDK::Models::PromoCode::promo_type,
        status: WhopSDK::Models::PromoCode::status,
        stock: Integer,
        unlimited_stock: bool,
        updated_at: String,
        uses: Integer
      }

      type account = { id: String, title: String }

      class Account < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor title: String

        def initialize: (id: String, title: String) -> void

        def to_hash: -> { id: String, title: String }
      end

