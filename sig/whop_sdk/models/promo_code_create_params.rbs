    class PromoCodeCreateParams < WhopSDK::Internal::Type::BaseModel
      extend WhopSDK::Internal::Type::RequestParameters::Converter
      include WhopSDK::Internal::Type::RequestParameters

      attr_accessor account_id: String

      attr_accessor amount_off: Float

      attr_accessor base_currency: WhopSDK::Models::PromoCodeCreateParams::base_currency

      attr_accessor code: String

      attr_accessor new_users_only: bool

      attr_accessor promo_duration_months: Integer

      attr_accessor promo_type: WhopSDK::Models::PromoCodeCreateParams::promo_type

      attr_reader churned_users_only: bool?

      def churned_users_only=: (bool) -> bool

      attr_reader existing_memberships_only: bool?

      def existing_memberships_only=: (bool) -> bool

      attr_accessor expires_at: String?

      attr_reader one_per_customer: bool?

      def one_per_customer=: (bool) -> bool

      attr_reader plan_ids: ::Array[String]?

      def plan_ids=: (::Array[String]) -> ::Array[String]

      attr_accessor product_id: String?

      attr_accessor stock: Integer?

      attr_reader unlimited_stock: bool?

      def unlimited_stock=: (bool) -> bool

      attr_reader api_version_date: String?

      def api_version_date=: (String) -> String

      attr_reader idempotency_key: String?

      def idempotency_key=: (String) -> String

      def initialize: (
        account_id: String,
        amount_off: Float,
        base_currency: WhopSDK::Models::PromoCodeCreateParams::base_currency,
        code: String,
        new_users_only: bool,
        promo_duration_months: Integer,
        promo_type: WhopSDK::Models::PromoCodeCreateParams::promo_type,
        ?churned_users_only: bool,
