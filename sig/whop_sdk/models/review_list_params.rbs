module WhopSDK
  module Models
    type review_list_params =
      {
        product_id: String,
        after: String,
        before: String,
        created_after: Time,
        created_before: Time,
        first: Integer,
        last: Integer,
        max_stars: Integer,
        min_stars: Integer
      }
      & WhopSDK::Internal::Type::request_parameters

    class ReviewListParams < WhopSDK::Internal::Type::BaseModel
      extend WhopSDK::Internal::Type::RequestParameters::Converter
      include WhopSDK::Internal::Type::RequestParameters

      attr_accessor product_id: String

      attr_reader after: String?

      def after=: (String) -> String

      attr_reader before: String?

      def before=: (String) -> String

      attr_reader created_after: Time?

      def created_after=: (Time) -> Time

      attr_reader created_before: Time?

      def created_before=: (Time) -> Time

      attr_reader first: Integer?

      def first=: (Integer) -> Integer

      attr_reader last: Integer?

      def last=: (Integer) -> Integer

      attr_reader max_stars: Integer?

      def max_stars=: (Integer) -> Integer

      attr_reader min_stars: Integer?

      def min_stars=: (Integer) -> Integer

      def initialize: (
        product_id: String,
        ?after: String,
        ?before: String,
        ?created_after: Time,
        ?created_before: Time,
        ?first: Integer,
        ?last: Integer,
        ?max_stars: Integer,
        ?min_stars: Integer,
        ?request_options: WhopSDK::request_opts
      ) -> void

      def to_hash: -> {
        product_id: String,
        after: String,
        before: String,
        created_after: Time,
        created_before: Time,
        first: Integer,
        last: Integer,
        max_stars: Integer,
        min_stars: Integer,
        request_options: WhopSDK::RequestOptions
      }
    end
  end
end
