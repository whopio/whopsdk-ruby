      end

      type status = :processing | :succeeded | :canceled | :requires_action

      module Status
        extend WhopSDK::Internal::Type::Enum

        PROCESSING: :processing
        SUCCEEDED: :succeeded
        CANCELED: :canceled
        REQUIRES_ACTION: :requires_action

        def self?.values: -> ::Array[WhopSDK::Models::SetupIntent::status]
      end

      type user =
        {
          id: String,
          name: String?,
          profile_picture: WhopSDK::SetupIntent::User::ProfilePicture,
          username: String
        }

      class User < WhopSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor name: String?

        attr_accessor profile_picture: WhopSDK::SetupIntent::User::ProfilePicture

        attr_accessor username: String

        def initialize: (
          id: String,
          name: String?,
          profile_picture: WhopSDK::SetupIntent::User::ProfilePicture,
          username: String
        ) -> void

        def to_hash: -> {
          id: String,
          name: String?,
          profile_picture: WhopSDK::SetupIntent::User::ProfilePicture,
          username: String
        }

        type profile_picture = { url: String }

        class ProfilePicture < WhopSDK::Internal::Type::BaseModel
          attr_accessor url: String

          def initialize: (url: String) -> void

          def to_hash: -> { url: String }
        end
      end
