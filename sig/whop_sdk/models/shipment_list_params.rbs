      attr_reader payment_id: String?

      def payment_id=: (String) -> String

      attr_reader user_id: String?

      def user_id=: (String) -> String

      def initialize: (
        ?after: String,
        ?before: String,
        ?company_id: String,
        ?first: Integer,
        ?last: Integer,
        ?payment_id: String,
        ?user_id: String,
        ?request_options: WhopSDK::request_opts
      ) -> void

      def to_hash: -> {
        after: String,
        before: String,
        company_id: String,
        first: Integer,
        last: Integer,
        payment_id: String,
        user_id: String,
