        company_id: String,
        first: Integer,
        last: Integer,
        payment_id: String,
        user_id: String
      }
      & WhopSDK::Internal::Type::request_parameters

    class ShipmentListParams < WhopSDK::Internal::Type::BaseModel
      extend WhopSDK::Internal::Type::RequestParameters::Converter
