      def initialize: (
        id: String,
        api_version_date: String?,
        data: WhopSDK::Shipment,
        timestamp: Time,
        ?company_id: String?,
        ?api_version: :v1,
        ?type: :"shipment.updated"
      ) -> void

      def to_hash: -> {
        id: String,
        api_version: :v1,
        api_version_date: String?,
        data: WhopSDK::Shipment,
        timestamp: Time,
        type: :"shipment.updated",
