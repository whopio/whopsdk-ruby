    type shipment_updated_webhook_event =
      {
        id: String,
        api_version: :v1,
        api_version_date: String?,
        data: WhopSDK::Shipment,
        timestamp: Time,
        type: :"shipment.updated",
        company_id: String?
      }

    class ShipmentUpdatedWebhookEvent < WhopSDK::Internal::Type::BaseModel
