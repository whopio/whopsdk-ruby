            external_id: String?,
            name: String?,
            platform: WhopSDK::Models::User::SocialAccount::ParentSocialAccount::platform,
            profile_picture_url: String?,
            username: String?,
            verified: bool
          }

          type platform =
            :x
            | :instagram
            | :youtube
            | :tiktok
            | :facebook
            | :discord
            | :telegram

          module Platform
            extend WhopSDK::Internal::Type::Enum

            X: :x
            INSTAGRAM: :instagram
            YOUTUBE: :youtube
            TIKTOK: :tiktok
            FACEBOOK: :facebook
            DISCORD: :discord
            TELEGRAM: :telegram

            def self?.values: -> ::Array[WhopSDK::Models::User::SocialAccount::ParentSocialAccount::platform]
          end
        end

        type platform =
          :x
