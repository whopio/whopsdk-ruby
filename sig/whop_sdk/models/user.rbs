              available: String,
              in_transit: String,
              pending: String,
              pending_settlements: ::Array[WhopSDK::User::Balance::Crypto::Breakdown::PendingSettlement],
              reserve: String
            }

            type pending_settlement = { amount: String, date: String }

            class PendingSettlement < WhopSDK::Internal::Type::BaseModel
              attr_accessor amount: String

              attr_accessor date: String

              def initialize: (amount: String, date: String) -> void

              def to_hash: -> { amount: String, date: String }
            end
          end
        end
      end

