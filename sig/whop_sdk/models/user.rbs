          type breakdown =
            {
              available: String,
              in_transit: String,
              pending: String,
              pending_settlements: ::Array[WhopSDK::User::Balance::Crypto::Breakdown::PendingSettlement],
              reserve: String
            }

          class Breakdown < WhopSDK::Internal::Type::BaseModel
            attr_accessor available: String

            attr_accessor in_transit: String

            attr_accessor pending: String

            attr_accessor pending_settlements: ::Array[WhopSDK::User::Balance::Crypto::Breakdown::PendingSettlement]

