module WhopSDK
  module Models
    type withdrawal_reversed_webhook_event =
      {
        id: String,
        api_version: :v1,
        api_version_date: String?,
        data: WhopSDK::Withdrawal,
        timestamp: Time,
        type: :"withdrawal.reversed",
        account_id: String?,
        previous_attributes: top
      }

    class WithdrawalReversedWebhookEvent < WhopSDK::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor api_version: :v1

      attr_accessor api_version_date: String?

      attr_accessor data: WhopSDK::Withdrawal

      attr_accessor timestamp: Time

      attr_accessor type: :"withdrawal.reversed"

      attr_accessor account_id: String?

      attr_reader previous_attributes: top?

      def previous_attributes=: (top) -> top

      def initialize: (
        id: String,
        api_version_date: String?,
        data: WhopSDK::Withdrawal,
        timestamp: Time,
        ?account_id: String?,
        ?previous_attributes: top,
        ?api_version: :v1,
        ?type: :"withdrawal.reversed"
      ) -> void

      def to_hash: -> {
        id: String,
        api_version: :v1,
        api_version_date: String?,
        data: WhopSDK::Withdrawal,
        timestamp: Time,
        type: :"withdrawal.reversed",
        account_id: String?,
        previous_attributes: top
      }
    end
  end
end
