        ?stats_to: String,
        ?status: WhopSDK::Models::AdCampaignListParams::status,
        ?time_zone: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Internal::CursorPage[WhopSDK::AdCampaign]

      def delete: (String id, ?request_options: WhopSDK::request_opts) -> bool

      def pause: (
        String id,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::AdCampaign

      def unpause: (
