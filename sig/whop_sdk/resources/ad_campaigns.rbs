        ?status: WhopSDK::Models::AdCampaignUpdateParams::status,
        ?title: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::AdCampaign

      def list: (
        ?account_id: String,
        ?after: String,
        ?before: String,
        ?created_after: String,
        ?created_before: String,
        ?direction: WhopSDK::Models::AdCampaignListParams::direction,
        ?first: Integer,
        ?last: Integer,
        ?order: WhopSDK::Models::AdCampaignListParams::order,
        ?query: String,
