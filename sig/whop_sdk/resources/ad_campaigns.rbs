        title: String,
        ?account_id: String,
        ?bid_type: WhopSDK::Models::AdCampaignCreateParams::bid_type,
        ?budget_amount: Float,
        ?budget_optimization: WhopSDK::Models::AdCampaignCreateParams::budget_optimization,
        ?budget_type: WhopSDK::Models::AdCampaignCreateParams::budget_type,
        ?desired_cost_per_result: Float,
        ?ends_at: String,
        ?special_ad_categories: ::Array[WhopSDK::Models::AdCampaignCreateParams::special_ad_category],
        ?starts_at: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::AdCampaign

      def retrieve: (
        String id,
        ?stats_from: String,
        ?stats_to: String,
        ?time_zone: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::AdCampaign

      def update: (
        String id,
        ?bid_type: WhopSDK::Models::AdCampaignUpdateParams::bid_type,
        ?budget_amount: Float,
        ?budget_optimization: WhopSDK::Models::AdCampaignUpdateParams::budget_optimization,
