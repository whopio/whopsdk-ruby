module WhopSDK
  module Resources
    class AdGroups
      def retrieve: (
        String id,
        ?attribution_model: WhopSDK::Models::AdGroupRetrieveParams::attribution_model,
        ?stats_from: String,
        ?stats_to: String,
        ?time_zone: String,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::AdGroup

      def update: (
        String id,
        ?audiences: WhopSDK::AdGroupUpdateParams::Audiences,
        ?bid_type: WhopSDK::Models::AdGroupUpdateParams::bid_type,
        ?budget_amount: Float,
        ?budget_type: WhopSDK::Models::AdGroupUpdateParams::budget_type,
        ?conversion_event: WhopSDK::Models::AdGroupUpdateParams::conversion_event?,
        ?conversion_location: WhopSDK::Models::AdGroupUpdateParams::conversion_location,
        ?demographics: WhopSDK::AdGroupUpdateParams::Demographics,
        ?desired_cost_per_result: Float,
        ?detailed_targeting: WhopSDK::AdGroupUpdateParams::DetailedTargeting,
        ?devices: WhopSDK::AdGroupUpdateParams::Devices,
        ?ends_at: String,
        ?frequency_cap: WhopSDK::AdGroupUpdateParams::FrequencyCap,
        ?languages: ::Array[String],
        ?message_apps: ::Array[WhopSDK::Models::AdGroupUpdateParams::message_app],
        ?minimum_daily_spend: Float,
        ?optimization_goal: WhopSDK::Models::AdGroupUpdateParams::optimization_goal,
        ?placements: WhopSDK::Models::AdGroupUpdateParams::placements,
        ?regions: WhopSDK::AdGroupUpdateParams::Regions,
        ?starts_at: String,
        ?status: WhopSDK::Models::AdGroupUpdateParams::status,
        ?title: String,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::AdGroup

      def list: (
        ?account_id: String,
        ?ad_campaign_id: String,
        ?ad_campaign_ids: ::Array[String],
        ?after: String,
        ?attribution_model: WhopSDK::Models::AdGroupListParams::attribution_model,
        ?before: String,
        ?created_after: String,
        ?created_before: String,
        ?direction: WhopSDK::Models::AdGroupListParams::direction,
        ?first: Integer,
        ?last: Integer,
        ?order: WhopSDK::Models::AdGroupListParams::order,
        ?query: String,
        ?stats_from: String,
        ?stats_to: String,
        ?status: WhopSDK::Models::AdGroupListParams::status,
        ?time_zone: String,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Internal::CursorPage[WhopSDK::AdGroup]

      def delete: (
        String id,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Models::AdGroupDeleteResponse

      def pause: (
        String id,
        ?api_version_date: String,
        ?idempotency_key: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::AdGroup

      def unpause: (
        String id,
        ?api_version_date: String,
        ?idempotency_key: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::AdGroup

      def initialize: (client: WhopSDK::Client) -> void
    end
  end
