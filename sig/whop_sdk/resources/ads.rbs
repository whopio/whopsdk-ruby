module WhopSDK
  module Resources
    class Ads
      def retrieve: (
        String id,
        ?attribution_model: WhopSDK::Models::AdRetrieveParams::attribution_model,
        ?stats_from: String,
        ?stats_to: String,
        ?time_zone: String,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Ad

      def list: (
        ?account_id: String,
        ?ad_campaign_id: String,
        ?ad_campaign_ids: ::Array[String],
        ?ad_group_id: String,
        ?ad_group_ids: ::Array[String],
        ?after: String,
        ?attribution_model: WhopSDK::Models::AdListParams::attribution_model,
        ?before: String,
        ?created_after: String,
        ?created_before: String,
        ?direction: WhopSDK::Models::AdListParams::direction,
        ?first: Integer,
        ?last: Integer,
        ?order: WhopSDK::Models::AdListParams::order,
        ?query: String,
        ?stats_from: String,
        ?stats_to: String,
        ?status: WhopSDK::Models::AdListParams::status,
        ?time_zone: String,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Internal::CursorPage[WhopSDK::Ad]

      def pause: (
        String id,
        ?api_version_date: String,
        ?idempotency_key: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Ad

      def unpause: (
        String id,
        ?api_version_date: String,
        ?idempotency_key: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Ad

      def initialize: (client: WhopSDK::Client) -> void
    end
  end
end
