module WhopSDK
  module Resources
    class Disputes
      def retrieve: (
        String id,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Dispute

      def list: (
        ?account_id: String,
        ?after: String,
        ?before: String,
        ?created_after: String,
        ?created_before: String,
        ?currency: String,
        ?direction: WhopSDK::Models::DisputeListParams::direction,
        ?first: Integer,
        ?last: Integer,
        ?order: WhopSDK::Models::DisputeListParams::order,
        ?status: ::Array[WhopSDK::Models::DisputeListParams::status],
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Internal::CursorPage[WhopSDK::Dispute]

      def submit_evidence: (
        String id,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Dispute

      def update_evidence: (
        String id,
        ?access_activity_log: String?,
        ?billing_address: String?,
        ?cancellation_policy_attachment: WhopSDK::DisputeUpdateEvidenceParams::CancellationPolicyAttachment?,
        ?cancellation_policy_disclosure: String?,
        ?customer_communication_attachment: WhopSDK::DisputeUpdateEvidenceParams::CustomerCommunicationAttachment?,
        ?customer_email_address: String?,
        ?customer_name: String?,
        ?notes: String?,
        ?product_description: String?,
        ?refund_policy_attachment: WhopSDK::DisputeUpdateEvidenceParams::RefundPolicyAttachment?,
        ?refund_policy_disclosure: String?,
        ?refund_refusal_explanation: String?,
        ?service_date: String?,
        ?uncategorized_attachment: WhopSDK::DisputeUpdateEvidenceParams::UncategorizedAttachment?,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Dispute

      def initialize: (client: WhopSDK::Client) -> void
    end
  end
end
