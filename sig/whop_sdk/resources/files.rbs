module WhopSDK
  module Resources
    class Files
      def create: (
        filename: String,
        ?byte_size: Integer,
        ?multipart: bool,
        ?visibility: WhopSDK::Models::FileCreateParams::visibility,
        ?api_version_date: String,
        ?idempotency_key: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Models::FileCreateResponse

      def retrieve: (
        String id,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Models::FileRetrieveResponse

      def initialize: (client: WhopSDK::Client) -> void
    end
  end
end
