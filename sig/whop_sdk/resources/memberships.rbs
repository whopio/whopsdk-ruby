module WhopSDK
  module Resources
    class Memberships
      def retrieve: (
        String id,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Membership

      def update: (
        String id,
        ?cancel_at_period_end: bool,
        ?metadata: top,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Membership

      def list: (
        ?account_id: String,
        ?after: String,
        ?before: String,
        ?created_after: String,
        ?created_before: String,
        ?direction: WhopSDK::Models::MembershipListParams::direction,
        ?first: Integer,
        ?last: Integer,
        ?order: WhopSDK::Models::MembershipListParams::order,
        ?plan_id: String,
        ?product_id: String,
        ?status: WhopSDK::Models::MembershipListParams::status,
        ?user_id: String,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Internal::CursorPage[WhopSDK::Membership]

      def add_free_days: (
        String id,
        free_days: Integer,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Membership

      def cancel: (
        String id,
        ?cancel_at_period_end: bool,
        ?reason: String,
        ?api_version_date: String,
        ?idempotency_key: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Membership

      def pause: (
        String id,
        ?until_: String,
        ?api_version_date: String,
        ?idempotency_key: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Membership

      def resume: (
        String id,
        ?api_version_date: String,
        ?idempotency_key: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Membership

      def uncancel: (
        String id,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Membership

      def initialize: (client: WhopSDK::Client) -> void
    end
  end
end
