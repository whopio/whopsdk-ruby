module WhopSDK
  module Resources
    class Products
      def create: (
        title: String,
        ?account_id: String,
        ?collect_shipping_address: bool?,
        ?custom_cta: WhopSDK::Models::ProductCreateParams::custom_cta?,
        ?custom_cta_url: String?,
        ?custom_statement_descriptor: String?,
        ?description: String?,
        ?global_affiliate_percentage: Float?,
        ?global_affiliate_status: WhopSDK::Models::ProductCreateParams::global_affiliate_status,
        ?headline: String?,
        ?labels: ::Array[String]?,
        ?member_affiliate_percentage: Float?,
        ?member_affiliate_status: WhopSDK::Models::ProductCreateParams::member_affiliate_status,
        ?metadata: top?,
        ?product_tax_code_id: String?,
        ?redirect_purchase_url: String?,
        ?route: String?,
        ?send_welcome_message: bool?,
        ?visibility: String,
        ?api_version_date: String,
        ?idempotency_key: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Product

      def retrieve: (
        String id,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Product

      def update: (
        String id,
        ?banner_image: WhopSDK::ProductUpdateParams::BannerImage?,
        ?description: String?,
        ?headline: String?,
        ?labels: ::Array[String]?,
        ?metadata: top?,
        ?product_tax_code_id: String?,
        ?send_welcome_message: bool?,
        ?title: String,
        ?visibility: String,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Product

      def list: (
        ?access_pass_types: ::Array[String],
        ?account_id: String,
        ?after: String,
        ?before: String,
        ?created_after: String,
        ?created_before: String,
        ?direction: WhopSDK::Models::ProductListParams::direction,
        ?first: Integer,
        ?labels: ::Array[String],
        ?last: Integer,
        ?marketplace_category_route: String,
        ?order: String,
        ?plan_types: ::Array[WhopSDK::Models::ProductListParams::plan_type],
        ?price_maximum: Float,
        ?price_minimum: Float,
        ?query: String,
        ?visibilities: ::Array[String],
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Internal::CursorPage[WhopSDK::ProductListItem]

      def delete: (
        String id,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Models::ProductDeleteResponse

      def initialize: (client: WhopSDK::Client) -> void
    end
  end
end
