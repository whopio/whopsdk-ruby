module WhopSDK
  module Resources
    class SetupIntents
      def retrieve: (
        String id,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::SetupIntent

      def list: (
        ?account_id: String,
        ?after: String,
        ?before: String,
        ?created_after: Time,
        ?created_before: Time,
        ?direction: WhopSDK::Models::SetupIntentListParams::direction,
        ?first: Integer,
        ?last: Integer,
        ?order: WhopSDK::Models::SetupIntentListParams::order,
        ?status: WhopSDK::Models::SetupIntentListParams::status,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Internal::CursorPage[WhopSDK::SetupIntent]

