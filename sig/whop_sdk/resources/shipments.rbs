module WhopSDK
  module Resources
    class Shipments
      def create: (
        payment_id: String,
        tracking_number: String,
        ?account_id: String,
        ?api_version_date: String,
        ?idempotency_key: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Shipment

      def retrieve: (
        String id,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Shipment

      def list: (
        ?account_id: String,
        ?after: String,
        ?before: String,
        ?created_after: String,
        ?created_before: String,
        ?direction: WhopSDK::Models::ShipmentListParams::direction,
        ?first: Integer,
        ?last: Integer,
        ?order: WhopSDK::Models::ShipmentListParams::order,
        ?payment_id: ::Array[String],
        ?status: WhopSDK::Models::ShipmentListParams::status,
        ?api_version_date: String,
        ?request_options: WhopSDK::request_opts
      ) -> WhopSDK::Internal::CursorPage[WhopSDK::Shipment]

      def initialize: (client: WhopSDK::Client) -> void
    end
  end
end
